<div id="<%= dom_id member %>">
  <div>
    <strong>Name:</strong>
    <%= member.name %>
  </div>

  <div>
    <strong>Surname:</strong>
    <%= member.surname %>
  </div>

  <div>
    <strong>Email address:</strong>
    <%= member.email_address %>
  </div>

  <div>
    <strong>Birthday:</strong>
    <%= member.birthday %>
  </div>

  <div>
    <strong>Club games played:</strong>
    <%= member.club_games_played %>
  </div>

  <div>
    <strong>Current rank:</strong>
    <%= member.current_rank %>
  </div>

</div>
